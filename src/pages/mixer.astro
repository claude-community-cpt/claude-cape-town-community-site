---
// claudecapetown.com/mixer is the short link guests are given at Claude &
// Coffee. It forwards straight to the Table Mixer app (repo: coffee-chat).
// It is a real page rather than a bare redirect so that the link shows a
// proper preview when it is shared in WhatsApp and the like.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";

const app = "https://table-mixer.vercel.app/";
---

<Base title="Table Mixer" description="Find your table at Claude & Coffee. Opens the Table Mixer, which tells you where to sit each round." noindex forwardTo={app}>
  <PageHead title="Table Mixer" lede="Taking you to the Table Mixer, which tells you where to sit each round." />
  <section class="section">
    <div class="wrap">
      <p><a class="btn btn-primary" href={app}>Open the Table Mixer</a></p>
    </div>
  </section>
</Base>
