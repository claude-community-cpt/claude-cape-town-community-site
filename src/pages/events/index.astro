---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import EventRow from "../../components/EventRow.astro";
import LumaEmbed from "../../components/LumaEmbed.astro";
import { getEvents, year, SITE, day, month, longDate, timeRange, whereLine, eventSchema } from "../../lib";

const { upcoming, past } = await getEvents();

// The ways to follow along, shown under the upcoming events. WhatsApp goes to
// the Join page, never to the group itself: its invite link is not public.
const joinLinks = [
  { href: SITE.lumaCalendar, label: "Luma calendar" },
  ...(SITE.discord ? [{ href: SITE.discord, label: "Discord" }] : []),
  { href: "/join/#whatsapp", label: "WhatsApp group" },
  ...SITE.hosts.map((host) => ({ href: host.linkedin, label: `${host.name} on LinkedIn` })),
];
const years = [...new Set(past.map((e) => year(e.data.start)))];
---

<Base
  title="Events"
  description="Upcoming and past Claude meetups, workshops and build days in Cape Town. Free, in person, and open to everyone. Register on Luma."
  schema={upcoming.map((event) => eventSchema(event))}
>
  <PageHead title="What's on" lede="Everything on the Cape Town calendar. Events are free, and you register on Luma." sticker="coffee" stickerWidth={190}>
    <p class="jump">
      <a class="pill pill-link" href="#upcoming">Upcoming ({upcoming.length})</a>
      <a class="pill pill-link" href="#past">Past ({past.length})</a>
    </p>
  </PageHead>

  <section class="section upcoming" id="upcoming" aria-labelledby="upcoming-title">
    <div class="wrap">
      <h2 class="heading" id="upcoming-title">Upcoming</h2>
      {
        upcoming.length === 0 && (
          <p class="lede empty">
            Nothing is scheduled right now. <a href={SITE.lumaCalendar} target="_blank" rel="noopener">Follow the Luma calendar</a> to hear first.
          </p>
        )
      }
      {
        upcoming.map((event) => (
          <article class:list={["up", "split", { "split-frame": !!event.data.luma?.embedId }]}>
            <div class="up-info">
              <div class="up-when">
                <div class="date-chip" aria-hidden="true">
                  <b>{day(event.data.start)}</b>
                  <span>{month(event.data.start)}</span>
                </div>
                <p class="small muted">
                  <time datetime={event.data.start.toISOString()}>{longDate(event.data.start)}</time>
                  <br />
                  {timeRange(event)}
                </p>
              </div>
              <h3 class="heading"><a href={`/events/${event.id}/`}>{event.data.title}</a></h3>
              <p class="muted summary">{event.data.summary}</p>
              <p class="small where">{whereLine(event)}</p>
              <div class="pills">
                <span class="pill">{event.data.format}</span>
                {event.data.status && <span class="pill pill-outline">{event.data.status}</span>}
              </div>
              <p class="actions">
                {event.data.luma && (
                  <a class="btn btn-primary" href={event.data.luma.url} target="_blank" rel="noopener">
                    {event.data.luma.label ?? "Register on Luma"}
                  </a>
                )}
                <a class="textlink" href={`/events/${event.id}/`}>Event details</a>
              </p>
            </div>
            {event.data.luma?.embedId && <LumaEmbed embedId={event.data.luma.embedId} title={event.data.title} />}
          </article>
        ))
      }
      <aside class="join" aria-labelledby="join-title">
        <div>
          <h3 class="title" id="join-title">Join the community</h3>
          <p class="muted">More events are coming. Follow along and you will hear about them first.</p>
        </div>
        <ul class="join-links">
          {joinLinks.map((link) => (
            <li>
              {link.href.startsWith("/") ? (
                <a class="textlink" href={link.href}>{link.label}</a>
              ) : (
                <a class="textlink" href={link.href} target="_blank" rel="noopener">{link.label}</a>
              )}
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section-alt" id="past" aria-labelledby="past-title">
    <div class="wrap">
      <h2 class="heading" id="past-title">Past events</h2>
      {
        years.map((y) => (
          <div class="year">
            <p class="year-label" aria-hidden="true">{y}</p>
            <div class="rows">
              {past.filter((e) => year(e.data.start) === y).map((event) => <EventRow event={event} />)}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section-coral">
    <div class="wrap cta">
      <div class="stack">
        <h2 class="heading">Have a room, or a talk?</h2>
        <p class="lede">We are always looking for places to gather and people with something to show.</p>
      </div>
      <p class="actions">
        <a class="btn btn-solid" href="/partner/">Host or support an event</a>
        <a class="textlink" href="/speak/">Give a talk</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .upcoming {
    padding-top: var(--space-5);
  }
  /* The event's details on the left, Luma's registration on the right. */
  .upcoming h2 + .up {
    margin-top: var(--space-6);
  }
  .up-info {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .up-when {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .where {
    font-weight: 500;
  }
  .up-info .actions {
    margin-top: var(--space-3);
  }
  .up-info h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .up-info h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--coral);
    text-decoration-thickness: 2px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
  }
  .empty {
    margin-top: var(--space-6);
  }
  /* "Join the community": the words on the left, the links on the right. */
  .join {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-7);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 2px solid var(--coral);
  }
  .join-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .year {
    display: grid;
    grid-template-columns: clamp(9rem, 14vw, 12rem) minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-7);
  }
  .year-label {
    position: sticky;
    top: 6rem;
    align-self: start;
    font: 300 var(--text-display) / 1 var(--font-display);
    color: var(--text-faint);
  }
  .rows > :global(.event-row:last-child) {
    border-bottom: 1px solid var(--line);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  @media (max-width: 44rem) {
    .year {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .year-label {
      position: static;
      font-size: var(--text-heading);
    }
  }
</style>
