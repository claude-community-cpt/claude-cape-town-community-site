---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import FormShell from "../components/FormShell.astro";
import { SITE } from "../lib";
import { isLive } from "../scripts/form-ids";

// The WhatsApp request form appears once it has a Google Form to post to.
const whatsappForm = isLive("whatsapp-form");

// The Discord card appears only while its link is set in src/lib.ts.
const ways = [
  {
    icon: "calendar",
    title: "Come to an event",
    text: "The best way in. Events are free and open to everyone, and you register on Luma.",
    links: [{ href: SITE.lumaCalendar, label: "See the Luma calendar" }],
  },
  SITE.discord && {
    icon: "discord",
    title: "Chat on Discord",
    text: "Ask questions, share what you are building and hear about events first.",
    links: [{ href: SITE.discord, label: "Join the Discord" }],
  },
  {
    icon: "linkedin",
    title: "Say hello on LinkedIn",
    text: "Connect with the ambassadors for event news, or to ask anything before you come along.",
    links: SITE.hosts.map((host) => ({ href: host.linkedin, label: `${host.name} on LinkedIn` })),
  },
  {
    icon: "people",
    title: "Meet the ambassadors",
    text: "The community is run by volunteer Claude Community Ambassadors. Find us in the official directory.",
    links: [{ href: SITE.ambassadors, label: "Ambassador directory" }],
  },
].filter((way) => !!way);
---

<Base title="Join" description="How to join Cape Town's Claude community: come to a free event and meet people building with Claude near you.">
  <PageHead coral title="Join the community" lede="There is nothing to sign up for. Come to an event and you are part of it." sticker="happy" />
  <section class="wrap body">
    <ul class="ways">
      {
        ways.map((way) => (
          <li>
            <span class="way-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="32" height="32">
                {way.icon === "calendar" && (
                  <g class="line">
                    <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
                    <path d="M3.5 10h17M8 3v4M16 3v4" />
                    <path class="fill" d="m12 12.2.9 1.8 2 .3-1.45 1.4.35 2L12 16.75l-1.8.95.35-2-1.45-1.4 2-.3z" />
                  </g>
                )}
                {way.icon === "discord" && (
                  <path
                    class="fill"
                    d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
                  />
                )}
                {way.icon === "linkedin" && (
                  <g class="fill">
                    <circle cx="5.6" cy="5.4" r="2.1" />
                    <rect x="3.8" y="9" width="3.6" height="11.5" />
                    <path d="M10 9h3.4v1.6c.6-1.1 1.9-1.9 3.6-1.9 3 0 4 1.9 4 4.9v6.9h-3.6v-6.1c0-1.5-.4-2.6-1.8-2.6s-2 1-2 2.6v6.1H10z" />
                  </g>
                )}
                {way.icon === "people" && (
                  <g class="line">
                    <circle cx="9" cy="8" r="3.2" />
                    <path d="M2.8 20c0-3.6 2.7-6 6.2-6s6.2 2.4 6.2 6" />
                    <circle class="fill" cx="17.2" cy="9.2" r="2.4" />
                    <path d="M17.4 14.3c2.3.2 3.9 2 3.9 4.7" />
                  </g>
                )}
              </svg>
            </span>
            <h2 class="title">{way.title}</h2>
            <p class="muted">{way.text}</p>
            <p class="links">
              {way.links.map((link) => (
                <a class="textlink" href={link.href} target="_blank" rel="noopener">
                  {link.label}
                </a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="section section-alt" id="whatsapp" aria-labelledby="whatsapp-title">
    <div class="wrap whatsapp">
      <div class="whatsapp-words">
        <h2 class="heading" id="whatsapp-title">The WhatsApp group</h2>
        <p>
          We also have a WhatsApp group, where the ambassadors announce upcoming events. To keep members' phone numbers away from spammers
          the link is not public.
        </p>
        {
          whatsappForm ? (
            <p>Send us your name and number and an ambassador will message you the link on WhatsApp. It can take a few days: we are volunteers.</p>
          ) : (
            <p>Ask an ambassador at an event and we will add you.</p>
          )
        }
      </div>
      {
        whatsappForm && (
          <FormShell
            id="whatsapp-form"
            submit="Ask to join"
            doneTitle="Thanks, we have your request."
            doneText="An ambassador will message you the link on WhatsApp."
            note="We only use your number to send you the link, then we delete it. Once you join, other members of the group can see your number."
          >
            <label class="field"><span class="field-label">Your name</span>
              <input class="field-input" type="text" name="name" placeholder="Your name" autocomplete="name" required /></label>
            <label class="field"><span class="field-label">WhatsApp number</span>
              <input class="field-input" type="tel" name="phone" placeholder="+27 82 123 4567" autocomplete="tel" inputmode="tel" pattern="\+?[0-9 ]{9,18}" title="A phone number, with the country code if it is not South African" required /></label>
            {/* The values must match the choices in the Google Form word for word. */}
            <label class="field"><span class="field-label">How did you find us? (optional)</span>
              <select class="field-input" name="about">
                <option value="">Choose one</option>
                <option value="Event">At an event</option>
                <option value="Luma">On Luma</option>
                <option value="LinkedIn">On LinkedIn</option>
                <option value="Community Website">This website</option>
              </select></label>
          </FormShell>
        )
      }
    </div>
  </section>
</Base>

<style>
  .body {
    padding-block: var(--space-8) var(--section);
  }
  #whatsapp {
    scroll-margin-top: 6rem;
  }
  .ways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* A coral tile beside the heading, with the words and links below. */
  .ways li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    align-items: center;
    align-content: start;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .ways li > :not(.way-icon, h2) {
    grid-column: 1 / -1;
  }
  .way-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--coral);
    color: var(--ink);
  }
  .ways li:nth-child(odd) .way-icon {
    rotate: -3deg;
  }
  .ways li:nth-child(even) .way-icon {
    rotate: 2deg;
  }
  .way-icon .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .way-icon .fill {
    fill: currentColor;
    stroke: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-2);
  }
  /* The words on the left, the request form on the right. */
  .whatsapp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-6) clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .whatsapp-words {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  @media (max-width: 56rem) {
    .whatsapp {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
