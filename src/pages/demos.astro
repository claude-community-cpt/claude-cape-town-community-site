---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import creature from "../assets/brand/creature.png";
---

<Base title="Demos" description="What Cape Town is building with Claude: demos shared at our meetups.">
  <PageHead title="What Cape Town is building" lede="Demos shared at our meetups. A demo, an artefact, a coded prototype." />
  <section class="wrap body">
    <div class="empty">
      <Image src={creature} alt="" width={120} class="pixel" />
      <p class="title">Nothing on the shelf yet</p>
      <p class="muted">Demos from our build nights are being collected. Yours could be the first one here.</p>
      <p><a class="btn btn-primary" href="/speak/">Share a demo</a></p>
    </div>
  </section>
</Base>

<style>
  .body {
    padding-bottom: var(--section);
  }
  .empty {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: clamp(2.5rem, 7vw, 5rem) var(--space-5);
    border: 2px dashed var(--line);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .empty :global(.pixel) {
    image-rendering: pixelated;
    margin-bottom: var(--space-3);
  }
</style>
