---
import Sticker from "./Sticker.astro";

// The title block at the top of every page except the home page.
interface Props {
  title: string;
  lede?: string;
  coral?: boolean;
  /** Name of a sticker in src/assets/brand/stickers/, shown beside the title on wide screens. */
  sticker?: string;
  stickerWidth?: number;
}
const { title, lede, coral = false, sticker, stickerWidth = 170 } = Astro.props;
---

<header class:list={["page-head", { "section-coral": coral }]}>
  <div class:list={["wrap", "head", { "has-sticker": !!sticker }]}>
    <div class="stack">
      <h1 class="display">{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {sticker && <Sticker name={sticker} width={stickerWidth} eager class="head-sticker" />}
  </div>
</header>

<style>
  .page-head {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 4vw, 3.5rem);
  }
  .page-head.section-coral {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .has-sticker {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-7);
  }
  /* The sticker is drawn by another component, so these rules are global to reach it. */
  .has-sticker :global(.head-sticker) {
    --tilt: 6deg;
  }
  @media (max-width: 52rem) {
    .has-sticker {
      grid-template-columns: 1fr;
    }
    .has-sticker :global(.head-sticker) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .page-head h1 {
      animation: head-in var(--speed-scene) var(--ease-out) both;
    }
  }
  @keyframes head-in {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }
</style>
