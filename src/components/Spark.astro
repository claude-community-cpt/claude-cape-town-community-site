---
// The Claude Community spark, drawn in the current text colour.
import raw from "../assets/brand/spark-ivory.svg?raw";
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: cls } = Astro.props;
const svg = raw
  .replace('fill="#FAF9F5"', 'fill="currentColor"')
  .replace("<svg ", `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
---

<span class:list={["spark", cls]} set:html={svg} />

<style>
  .spark {
    display: inline-flex;
    flex: none;
    line-height: 0;
  }
</style>
