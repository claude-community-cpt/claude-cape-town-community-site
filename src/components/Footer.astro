---
import Spark from "./Spark.astro";
import { SITE } from "../lib";
const yearNow = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="about">
      <p class="lock"><Spark size={20} /><span class="wordmark">Claude Community Cape Town</span></p>
      <p>Free meetups, workshops and build days for people who make things with Claude, across the Mother City.</p>
      <p>
        Run by volunteer <a href={SITE.ambassadors} target="_blank" rel="noopener">Claude Community Ambassadors</a>.
      </p>
    </div>
    <nav aria-label="Community">
      <h2 class="wordmark">Community</h2>
      <ul>
        <li><a href="/events/">Events</a></li>
        <li><a href="/speak/">Give a talk</a></li>
        <li><a href="/partner/">Host or support an event</a></li>
        <li><a href="/join/">Join</a></li>
      </ul>
    </nav>
    <nav aria-label="Elsewhere">
      <h2 class="wordmark">Elsewhere</h2>
      <ul>
        <li><a href={SITE.lumaCalendar} target="_blank" rel="noopener">Luma calendar</a></li>
        {SITE.discord && (
          <li>
            <a href={SITE.discord} target="_blank" rel="noopener">Discord</a>
          </li>
        )}
        <li><a href="https://github.com/claude-community-cpt" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="https://claude.com/product/claude-code" target="_blank" rel="noopener">Claude Code</a></li>
        <li><a href="https://docs.anthropic.com/" target="_blank" rel="noopener">Documentation</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap base">
    <span>© {yearNow} Claude Community Cape Town</span>
    <span class="links">
      <a href="/privacy/">Privacy</a>
      <a href="/styleguide/">Design system</a>
    </span>
    <span class="built">Built with Claude in Cape Town</span>
  </div>
</footer>

<style>
  /* The footer is ink in both themes. */
  .site-footer {
    background: #141413;
    color: #faf9f5;
    padding-block: clamp(3rem, 6vw, 4.5rem) var(--space-6);
    font-size: var(--text-small);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(16rem, 2fr) 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .about p + p {
    margin-top: var(--space-3);
  }
  .about p:not(.lock) {
    max-width: 34ch;
    color: rgb(250 249 245 / 0.75);
  }
  .lock {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-4);
  }
  .lock :global(.spark) {
    color: var(--coral);
  }
  h2 {
    margin-bottom: var(--space-4);
  }
  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: rgb(250 249 245 / 0.78);
    text-decoration: none;
  }
  .about a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: #faf9f5;
    text-decoration: underline;
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(250 249 245 / 0.15);
    font-size: var(--text-label);
    color: rgb(250 249 245 / 0.75);
  }
  .links {
    display: flex;
    gap: var(--space-5);
  }
  .built {
    font-family: var(--font-mono);
  }
  @media (max-width: 44rem) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
