---
// A photo grid for one event. Photos live in src/assets/gallery/<folder>/ and
// are resized at build time. Click a photo for the full-size view.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  folder: string;
  alt?: Record<string, string>;
}
const { folder, alt = {} } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/gallery/*/*.{jpg,jpeg,png,webp}", { eager: true });
const photos = await Promise.all(
  Object.entries(files)
    .filter(([path]) => path.includes(`/gallery/${folder}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => {
      const name = path.split("/").pop()!;
      const thumb = await getImage({ src: mod.default, width: 720, format: "webp", quality: 70 });
      const full = await getImage({ src: mod.default, width: 1600, format: "webp", quality: 75 });
      return { name, thumb, full, alt: alt[name] ?? "", wide: mod.default.width > mod.default.height * 1.3 };
    }),
);
---

<ul class="gallery" data-gallery>
  {
    photos.map((p) => (
      <li class:list={{ wide: p.wide }}>
        <a href={p.full.src} aria-label={`Open photo: ${p.alt || p.name}`}>
          <img src={p.thumb.src} alt={p.alt} width={p.thumb.attributes.width} height={p.thumb.attributes.height} loading="lazy" decoding="async" />
        </a>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" data-lightbox aria-label="Photo">
  <form method="dialog"><button class="close" type="submit" aria-label="Close">✕</button></form>
  <figure></figure>
</dialog>

<script>
  // Without JavaScript the links simply open the full-size photo.
  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const box = gallery.nextElementSibling as HTMLDialogElement | null;
    const frame = box?.querySelector("figure");
    if (!box || !frame || typeof box.showModal !== "function") continue;
    const img = document.createElement("img");
    for (const attr of frame.attributes) img.setAttribute(attr.name, attr.value); // keep the scoped styles
    gallery.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest("a");
      if (!link) return;
      event.preventDefault();
      img.src = link.href;
      img.alt = link.querySelector("img")?.alt ?? "";
      frame.replaceChildren(img);
      box.showModal();
    });
    box.addEventListener("click", (event) => {
      if (event.target === box) box.close();
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    grid-auto-rows: 15rem;
    grid-auto-flow: dense;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wide {
    grid-column: span 2;
  }
  a {
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    cursor: zoom-in;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--speed-scene) var(--ease-out);
  }
  a:hover img {
    scale: 1.04;
  }
  .lightbox {
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: var(--space-5);
    border: 0;
    background: rgb(20 20 19 / 0.94);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade var(--speed-move) var(--ease-out);
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox figure {
    display: contents;
  }
  .lightbox img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 3rem);
    object-fit: contain;
    border-radius: var(--radius-sm);
  }
  .close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid rgb(250 249 245 / 0.5);
    border-radius: 50%;
    background: transparent;
    color: #faf9f5;
    font-size: 1.2rem;
    cursor: pointer;
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @media (max-width: 40rem) {
    .gallery {
      grid-auto-rows: 11rem;
    }
    .wide {
      grid-column: auto;
    }
  }
</style>
