---
// One event as a row: date chip, title, when and where, and its links.
import PhotoStrip from "./PhotoStrip.astro";
import { type EventEntry, day, month, longDate, timeRange, endOf } from "../lib";

interface Props {
  event: EventEntry;
  /** Heading level for the title, so the page outline stays in order. */
  level?: 2 | 3;
}
const { event, level = 3 } = Astro.props;
const { data } = event;
const past = endOf(event) < new Date();
const Title = `h${level}` as "h2" | "h3";
const href = `/events/${event.id}/`;
---

<article class:list={["event-row", { "is-past": past }]}>
  <div class:list={["date-chip", { "is-past": past }]} aria-hidden="true">
    <b>{day(data.start)}</b><span>{month(data.start)}</span>
  </div>
  <div class="body">
    <div class="main">
      <p class="when small muted">
        <time datetime={data.start.toISOString()}>{longDate(data.start)}</time>{!past && `, ${timeRange(event)}`}
      </p>
      <Title class="title"><a href={href}>{data.title}</a></Title>
      <p class="summary muted">{data.summary}</p>
    </div>
    <div class="meta">
      <div class="pills">
        <span class="pill">{data.format}</span>
        <span class="pill pill-outline">{data.venue.name}</span>
        {!past && data.status && <span class="pill pill-outline">{data.status}</span>}
      </div>
      {
        (data.slides.length > 0 || data.photos || data.gallery || data.luma) && (
          <p class="links">
            {data.luma && (
              <a href={data.luma.url} target="_blank" rel="noopener">
                {past ? "View on Luma" : (data.luma.label ?? "Register on Luma")}
              </a>
            )}
            {data.slides.map((s) => (
              <a href={s.url} target="_blank" rel="noopener">
                {s.title}
              </a>
            ))}
            {data.gallery && <a href={`${href}#photos`}>Photos</a>}
            {data.photos && (
              <a href={data.photos} target="_blank" rel="noopener">
                Full photo album
              </a>
            )}
          </p>
        )
      }
      {past && data.gallery && <PhotoStrip folder={data.gallery} href={`${href}#photos`} label={`Photos from ${data.title}`} />}
    </div>
  </div>
</article>

<style>
  .event-row {
    position: relative;
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
    container-type: inline-size;
  }
  /* Words on the left, the place, links and photos on the right, so a row
     uses the full width. On narrower screens they stack. */
  .body {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: var(--space-3) var(--space-7);
    align-items: start;
  }
  .main,
  .meta {
    min-width: 0;
    display: grid;
    gap: var(--space-2);
  }
  .meta {
    justify-items: end;
    padding-top: var(--space-1);
    text-align: right;
  }
  .meta .pills,
  .meta .links {
    justify-content: flex-end;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  /* The whole row is the link to the event page. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .event-row:hover .title a {
    text-decoration: underline;
    text-decoration-color: var(--coral);
    text-decoration-thickness: 2px;
  }
  .date-chip {
    transition: rotate var(--speed-move) var(--ease-out);
  }
  .event-row:hover .date-chip {
    rotate: -4deg;
  }
  .summary {
    max-width: 46rem;
  }
  .links {
    position: relative; /* above the row link */
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  /* Links are chips like the tags beside them, outlined in the link colour. */
  .links a {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.8rem;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px currentColor;
    color: var(--accent-text);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
  }
  .links a:hover {
    background: var(--accent-tint);
  }
  .meta > :global(.strip) {
    position: relative; /* above the row link */
    z-index: 1;
  }
  @container (max-width: 54rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Tags and links share a line; photos take the next one. */
    .meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      padding-top: var(--space-1);
      text-align: left;
    }
    /* One wrapping line of chips. */
    .meta .pills {
      display: contents;
    }
    .meta .links {
      justify-content: flex-start;
    }
    .meta > :global(.strip) {
      flex-basis: 100%;
    }
  }
  @media (max-width: 30rem) {
    .event-row {
      gap: var(--space-4);
    }
  }
</style>
