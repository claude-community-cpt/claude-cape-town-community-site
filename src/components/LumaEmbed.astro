---
// Luma's registration frame for one event. It fills the width it is given,
// and its height follows that width so nobody has to scroll inside it (the
// heights are in src/styles/global.css). `embedId` is the evt-... id from
// Luma's "Embed event" snippet (Share, then Embed, on the event's manage page).
interface Props {
  embedId: string;
  title: string;
  /** A finished event shows less in the frame, so it can be shorter. */
  past?: boolean;
}
const { embedId, title, past = false } = Astro.props;
---

<div class:list={["luma-box", { "is-past": past }]}>
<iframe
  class="luma"
  src={`https://luma.com/embed/event/${embedId}/simple`}
  title={past ? `On Luma: ${title}` : `Register on Luma: ${title}`}
  loading="lazy"
  allow="fullscreen; payment"></iframe>
</div>
