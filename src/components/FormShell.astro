---
// Wraps a form with its "sent" and "error" messages. src/scripts/forms.ts looks
// for <id>, <id>-done and <id>-error.
interface Props {
  id: string;
  submit: string;
  doneTitle: string;
  doneText: string;
}
const { id, submit, doneTitle, doneText } = Astro.props;
---

<form class="form card" id={id} novalidate>
  <slot />
  <label class="field-trap" aria-hidden="true">Leave this empty <input type="text" name="company_url" tabindex="-1" autocomplete="off" /></label>
  <p><button class="btn btn-primary" type="submit">{submit}</button></p>
  <p class="small muted">We only use this to reply to you. See the <a href="/privacy/">privacy note</a>.</p>
  <p class="form-note" id={`${id}-error`} role="alert" hidden>
    That didn't go through. Check your connection and try again, or <a href="https://www.linkedin.com/in/tessa-verster/" target="_blank" rel="noopener">message Tessa on LinkedIn</a>.
  </p>
</form>
<div class="card done" id={`${id}-done`} hidden>
  <p class="form-note">{doneTitle}</p>
  <p class="muted">{doneText}</p>
</div>

<script>
  import "../scripts/forms";
</script>

<style>
  .done {
    display: grid;
    gap: var(--space-2);
    text-align: center;
  }
</style>
