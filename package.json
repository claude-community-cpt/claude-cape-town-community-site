    "@fontsource-variable/lora": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "astro": "7.4.13",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "html-validate": "11.21.1"
  }
}
